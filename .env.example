# Optional shell configuration; copy to .env and load as in docs/account-setup.md.
# This file is not automatically loaded by Python or Modal.
WANDB_ENTITY=chefOST
WANDB_PROJECT=vidosc-experiments
# Authenticate with `.venv/bin/python -m wandb login`, or set a key here instead.
# WANDB_API_KEY=

# Authenticate with `python -m modal token new` and activate your own profile first.
# Optionally pin this shell to the exact name shown by `python -m modal profile list`.
# MODAL_PROFILE=your-profile-name
MODAL_ENVIRONMENT=main

# Use existing local read-only R2 credentials; do not put AWS keys in this file.
AWS_PROFILE=chefost-r2
# After both logins, setup_accounts.py --r2-secret --workspace YOUR_WORKSPACE copies
# that profile to your workspace/environment's `chefost-r2` Secret for the mount.
